# Copy to .env only for an approved local environment. Never commit real values.
# 四个 Java HTTP 模块默认随若依启用；可逐项设为 false 并重启若依。
INTERVIEW_ENABLED=true
FASHION_ENABLED=true
ADEN_ENABLED=true
APS_ENABLED=true
APS_REPORTING_ENABLED=true
# Aden/APS 默认启用前必须准备目标数据库及对应已迁移 schema。
ADEN_EXPECTED_DATABASE=
APS_DB_URL=
APS_DB_USERNAME=
# APS_DB_PASSWORD 由平台密钥用途 platform.aps.db 注入。
APS_SITE_CODE=
# 排产求解 Worker 是同一 Maven 工程内的独立进程，不随若依 API 自动启动。
APS_WORKER_ENABLED=false
APS_WORKER_POLLING_ENABLED=false
INTERVIEW_DB_URL=jdbc:postgresql://localhost:5432/ai_interview_coach
INTERVIEW_DB_USERNAME=aic_app
# INTERVIEW_DB_PASSWORD 由平台密钥用途 platform.interview.db 注入。
INTERVIEW_BUSINESS_REST_ENDPOINTS_ENABLED=true
INTERVIEW_RELEASE_VERSION=0.1.0-SNAPSHOT
INTERVIEW_CATALOG_REST_ENDPOINTS_ENABLED=true
# Must reference the approved tenant that owns public catalog content.
INTERVIEW_CATALOG_PUBLIC_TENANT_ID=
# Local/UAT fixture only; production remains false.
INTERVIEW_CATALOG_SEED_ENABLED=false

# Provider 非秘密参数；凭据在若依 AI 密钥模块维护。
# Live interview orchestration favors the low-latency/cost model; evaluation may use the quality model.
INTERVIEW_DEEPSEEK_BASE_URL=https://api.deepseek.com
INTERVIEW_DEEPSEEK_INTERVIEW_MODEL=deepseek-v4-flash
INTERVIEW_DEEPSEEK_EVALUATION_MODEL=deepseek-v4-pro
INTERVIEW_DEEPSEEK_THINKING_MODE=disabled

# 火山语音鉴权模式和凭据组由若依 AI 密钥模块维护。
INTERVIEW_VOLCENGINE_ASR_RESOURCE_ID=
INTERVIEW_VOLCENGINE_TTS_RESOURCE_ID=
INTERVIEW_VOLCENGINE_ASR_MODEL=doubao-streaming-asr-2.0
INTERVIEW_VOLCENGINE_ASR_FALLBACK_MODEL=doubao-file-asr-2.0
INTERVIEW_VOLCENGINE_ASR_LANGUAGE=zh-CN
INTERVIEW_VOLCENGINE_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
INTERVIEW_VOLCENGINE_TTS_MODEL=doubao-tts-2.0
# Fill with the approved neutral interviewer voice ID from the voice library.
INTERVIEW_VOLCENGINE_TTS_VOICE=
INTERVIEW_VOLCENGINE_TTS_LANGUAGE=zh-CN
INTERVIEW_VOLCENGINE_TTS_AUDIO_FORMAT=mp3
INTERVIEW_VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
INTERVIEW_VOLCENGINE_TTS_SAMPLE_RATE=24000
