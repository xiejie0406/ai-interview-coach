{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-interview-coach.local/contracts/learning-plan-v1.json",
  "title": "LearningPlanCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceReportVersionId", "items", "limitations"],
  "properties": {
    "sourceReportVersionId": {"type": "string", "minLength": 1, "maxLength": 128},
    "items": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "questionVersionId", "weaknessRef", "reasonCodes", "priority"],
        "properties": {
          "itemId": {"type": "string", "minLength": 1, "maxLength": 128},
          "questionVersionId": {"type": "string", "minLength": 1, "maxLength": 128},
          "weaknessRef": {"type": "string", "minLength": 1, "maxLength": 128},
          "reasonCodes": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 96}, "uniqueItems": true},
          "priority": {"type": "integer", "minimum": 1, "maximum": 5},
          "suggestedDueAt": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "limitations": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 500}}
  }
}
