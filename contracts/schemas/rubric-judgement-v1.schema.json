{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-interview-coach.local/contracts/rubric-judgement-v1.json",
  "title": "RubricJudgementV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubricVersionId", "dimensions", "limitations"],
  "properties": {
    "rubricVersionId": {"type": "string", "minLength": 1, "maxLength": 128},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimensionId", "judgement", "confidence", "insufficientEvidence", "reasonCodes", "evidenceIds"],
        "properties": {
          "dimensionId": {"type": "string", "minLength": 1, "maxLength": 128},
          "judgement": {"type": "string", "enum": ["CORRECT", "PARTIAL", "INCORRECT", "INSUFFICIENT", "CONFLICTING"]},
          "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
          "insufficientEvidence": {"type": "boolean"},
          "reasonCodes": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 96}, "uniqueItems": true},
          "evidenceIds": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 128}, "uniqueItems": true}
        }
      }
    },
    "limitations": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 500}}
  }
}
