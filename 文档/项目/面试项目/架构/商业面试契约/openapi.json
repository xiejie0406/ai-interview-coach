        "description": "Bearer通过fetch流读取。Last-Event-ID为不透明cursor；7天候选保留，15秒heartbeat；至少一次投递按eventId去重。过期410先读取快照。",
        "parameters": [
          {
            "name": "interviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE id=eventId，data=InterviewEventV2 JSON；心跳为注释行",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "x-event-schema": {
