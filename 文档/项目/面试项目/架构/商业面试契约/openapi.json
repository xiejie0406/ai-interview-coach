  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "复用RuoYi主体，不能由请求body选择owner。"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"v[0-9]+\"$"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 512
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      }
    },
    "responses": {
      "Error": {
        "description": "业务/系统/外部失败；稳定code与恢复动作，敏感内部信息不透传。",
        "headers": {
          "Retry-After": {
            "description": "仅429/可重试503适用，秒数",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./schemas.json#/$defs/ErrorEnvelope"
            },
            "examples": {
              "businessRejection": {
                "summary": "业务拒绝",
                "value": {
                  "error": {
                    "code": "INVALID_STATE",
                    "userMessage": "面试已暂停，请恢复后再提交。",
                    "retryable": false,
                    "correlationId": "example-correlation",
                    "details": {
                      "recoveryAction": "READ_SNAPSHOT"
                    }
                  }
                }
              },
              "systemFailure": {
                "summary": "系统容量不足",
                "value": {
                  "error": {
                    "code": "CAPACITY_EXCEEDED",
                    "userMessage": "当前服务繁忙，请稍后重试。",
                    "retryable": true,
                    "correlationId": "example-correlation",
                    "details": {}
                  }
                }
              },
              "providerFailure": {
                "summary": "依赖不可用",
                "value": {
                  "error": {
                    "code": "PROVIDER_UNAVAILABLE",
                    "userMessage": "语音服务暂不可用，可使用文字继续。",
                    "retryable": true,
                    "correlationId": "example-correlation",
                    "details": {
                      "recoveryAction": "USE_TEXT"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
