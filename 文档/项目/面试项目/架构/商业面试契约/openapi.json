    "/interviews/{interviewId}/commands/{command}": {
      "post": {
        "operationId": "commandCommercialInterview",
        "summary": "提交受控会话命令",
        "description": "合法动作按快照allowedCommands与领域状态校验；非法状态409，版本过期412。先提交命令和Outbox再响应202。pause/cancel受理时同步阻断新的媒体/模型写入；Operation跟踪剩余清理。",
        "parameters": [
          {
            "name": "interviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "command",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "start",
                "pause",
                "resume",
                "skip",
                "complete",
                "cancel",
                "recover"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "202": {
            "description": "请求持久化接收；查询operation，不能视为任务完成",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas.json#/$defs/Operation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
